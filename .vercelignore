server/
tests/

# Ignore test files
*.test.ts
*.test.tsx
coverage/

# Ignore documentation
docs/
*.md

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore git files
.git/
.gitignore