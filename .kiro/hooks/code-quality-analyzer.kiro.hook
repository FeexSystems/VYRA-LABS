{
  "enabled": true,
  "name": "Code Quality Analyzer",
  "description": "Monitors source code files for changes and analyzes modified code for potential improvements including code smells, design patterns, and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified code in the changed files for potential improvements. Focus on:\n\n1. Code smells and anti-patterns\n2. Opportunities to apply better design patterns\n3. Best practices for readability and maintainability\n4. Performance optimization opportunities\n5. Type safety improvements (for TypeScript files)\n6. Error handling improvements\n7. Code duplication reduction\n\nProvide specific, actionable suggestions while maintaining existing functionality. Include code examples where helpful and prioritize the most impactful improvements."
  }
}